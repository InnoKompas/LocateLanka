{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "start:cluster": "node dist/cluster.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "start:prod:cluster": "NODE_ENV=production CLUSTER_ENABLED=true node dist/cluster.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:cluster": "ts-node-dev --respawn --transpile-only src/cluster.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only --watch src src/server.ts",
    "dev:debug": "ts-node-dev --inspect --respawn --transpile-only src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:health": "ts-node src/scripts/healthCheck.ts",
    "test:endpoints": "ts-node src/scripts/testEndpoints.ts",
    "check:db": "ts-node src/scripts/checkDatabase.ts",
    "manage:keys": "ts-node src/scripts/manageApiKeys.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint",
    "docker:build": "docker build -t lankalocate-server .",
    "docker:run": "docker run -p 3000:3000 lankalocate-server",
    "docker:prod": "docker run -e NODE_ENV=production -p 3000:3000 lankalocate-server",
    "seed:apikey": "ts-node src/scripts/seedApiKey.ts",
    "seed:usage": "ts-node src/scripts/seedUsageData.ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "seed:admin:single": "ts-node src/scripts/seedAdmin.ts single",
    "seed:admin:multiple": "ts-node src/scripts/seedAdmin.ts multiple",
    "seed:admin:custom": "ts-node src/scripts/seedAdmin.ts custom",
    "check:admin": "ts-node src/scripts/checkAdminUsers.ts",
    "reset:admin": "ts-node src/scripts/resetAdmin.ts",
    "test:admin-login": "ts-node src/scripts/testAdminLogin.ts",
    "db:migrate": "echo \"Add migration scripts here\"",
    "logs": "tail -f logs/app.log",
    "clean": "rm -rf dist node_modules/.cache",
    "reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm install"
  },
  "keywords": [],
  "author": "Ahzem",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb": "^4.0.7",
    "axios": "^1.12.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1"
  }
}
